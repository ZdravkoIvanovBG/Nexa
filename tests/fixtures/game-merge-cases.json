{
  "records": [
    {
      "name": "a newer state group replaces an older one",
      "stored": { "status": "paused", "progress": 20, "stateAt": 100 },
      "incoming": { "status": "playing", "progress": 35, "stateAt": 200 },
      "expected": { "status": "playing", "progress": 35, "stateAt": 200 }
    },
    {
      "name": "an older state group is ignored",
      "stored": { "status": "completed", "completedAt": 150, "stateAt": 200 },
      "incoming": { "status": "playing", "completedAt": null, "stateAt": 100 },
      "expected": { "status": "completed", "completedAt": 150, "stateAt": 200 }
    },
    {
      "name": "a newer note survives alongside a newer stored status",
      "stored": { "status": "completed", "stateAt": 300, "notes": "old", "notesAt": 100 },
      "incoming": {
        "status": "playing",
        "stateAt": 100,
        "notes": "Exploring Rome.",
        "notesAt": 200
      },
      "expected": {
        "status": "completed",
        "stateAt": 300,
        "notes": "Exploring Rome.",
        "notesAt": 200
      }
    },
    {
      "name": "a newer stored note survives a newer incoming status",
      "stored": { "status": "paused", "stateAt": 100, "notes": "Sequence 4", "notesAt": 300 },
      "incoming": { "status": "playing", "stateAt": 200, "notes": "", "notesAt": 100 },
      "expected": { "status": "playing", "stateAt": 200, "notes": "Sequence 4", "notesAt": 300 }
    },
    {
      "name": "a status change on one device cannot overwrite a rank from another",
      "stored": {
        "tier": "S",
        "tierPosition": "U1",
        "tierAt": 300,
        "status": "playing",
        "stateAt": 100
      },
      "incoming": {
        "tier": null,
        "tierPosition": null,
        "tierAt": 0,
        "status": "completed",
        "stateAt": 200
      },
      "expected": {
        "tier": "S",
        "tierPosition": "U1",
        "tierAt": 300,
        "status": "completed",
        "stateAt": 200
      }
    },
    {
      "name": "removing a tile beats an older rank",
      "stored": { "tier": "A", "tierPosition": "U1", "tierAt": 100 },
      "incoming": { "tier": "hidden", "tierPosition": null, "tierAt": 200 },
      "expected": { "tier": "hidden", "tierPosition": null, "tierAt": 200 }
    },
    {
      "name": "all three groups can come from different sides",
      "stored": {
        "status": "dropped",
        "stateAt": 100,
        "notes": "kept",
        "notesAt": 300,
        "tier": "F",
        "tierPosition": "a",
        "tierAt": 100
      },
      "incoming": {
        "status": "playing",
        "stateAt": 200,
        "notes": "older",
        "notesAt": 200,
        "tier": "S",
        "tierPosition": "b",
        "tierAt": 200
      },
      "expected": {
        "status": "playing",
        "stateAt": 200,
        "notes": "kept",
        "notesAt": 300,
        "tier": "S",
        "tierPosition": "b",
        "tierAt": 200
      }
    }
  ],
  "queue": [
    {
      "name": "a newer move replaces an older one",
      "stored": { "position": "U1", "updatedAt": 100 },
      "incoming": { "position": "V1", "updatedAt": 200 },
      "expected": { "position": "V1", "updatedAt": 200 }
    },
    {
      "name": "an older move is skipped",
      "stored": { "position": "V1", "updatedAt": 200 },
      "incoming": { "position": "U1", "updatedAt": 100 },
      "expected": { "position": "V1", "updatedAt": 200 }
    },
    {
      "name": "a newer tombstone removes the row",
      "stored": { "deletedAt": null, "updatedAt": 100 },
      "incoming": { "deletedAt": 200, "updatedAt": 200 },
      "expected": { "deletedAt": 200, "updatedAt": 200 }
    },
    {
      "name": "an older edit cannot resurrect a tombstone",
      "stored": { "deletedAt": 200, "updatedAt": 200 },
      "incoming": { "deletedAt": null, "updatedAt": 100 },
      "expected": { "deletedAt": 200, "updatedAt": 200 }
    },
    {
      "name": "undo beats the tombstone it restores",
      "stored": { "deletedAt": 200, "updatedAt": 200 },
      "incoming": { "deletedAt": null, "updatedAt": 201 },
      "expected": { "deletedAt": null, "updatedAt": 201 }
    }
  ]
}
